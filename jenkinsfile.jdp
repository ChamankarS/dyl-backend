pipeline {
    agent any
    stages {
        stage('PULL') {
            steps{
                git branch: 'feature', url: 'https://github.com/ChamankarS/dyl-backend.git'
            }
        }
        stage('BUILD') {
            steps{
               withDockerRegistry(credentialsId: 'docker-cred', toolName: 'docker') {
                    sh '''docker build . -t chamankarsahil/dyl-backend:latest               
                    docker push chamankarsahil/dyl-backend:latest
                    docker rmi chamankarsahil/dyl-backend:latest'''
                    }
                  
                    // echo "Joker@1507" | docker login --username chamankarsahil --password-stdin
            }
        }
   
        stage('DEPLOY') {
            steps {
                sh '''kubectl config current-context
                    kubectl apply -f ./yaml/'''
            }
        }
    }
}